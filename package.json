{
  "name": "professional-access-marketplace",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "migrate:up": "pnpm --filter @marketplace/db run migrate:up",
    "migrate:down": "pnpm --filter @marketplace/db run migrate:down"
  }
}
