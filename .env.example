# Shared
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_dev
REDIS_URL=redis://localhost:6379
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

# apps/orchestrator
PORT=3000

# apps/orchestrator — providers (optional in dev; log adapter used when absent)
# CALCOM_API_URL=https://cal.example.com/api/v1
# CALCOM_API_KEY=cal_xxx
# Safaricom Daraja (M-Pesa STK Push) — preferred payments provider when set.
# MPESA_CONSUMER_KEY=xxx
# MPESA_CONSUMER_SECRET=xxx
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=xxx
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Callback is unsigned; the random token in the URL is the auth. Must match:
# MPESA_CALLBACK_URL=https://your-public-host/webhooks/mpesa/<token>
# MPESA_CALLBACK_TOKEN=<token, 16+ random chars>
# PAYSTACK_SECRET_KEY=sk_test_xxx
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Marketplace <no-reply@example.com>
# WA_GATEWAY_URL=http://localhost:3001

# apps/web (Next.js, port 3002)
ORCHESTRATOR_URL=http://localhost:3000
# Public origin the QR posters encode; set to your real domain in production
# so scanned codes resolve for anyone, not just localhost.
PUBLIC_WEB_URL=http://localhost:3002
# Admin portal token (defaults to dev-admin in development).
# ADMIN_TOKEN=change-me

# apps/wa-gateway (run as a separate process with its own PORT)
# PORT=3001
ORCHESTRATOR_BASE_URL=http://localhost:3000
OPENWA_API_URL=http://localhost:2785
# OPENWA_API_KEY=openwa-key
