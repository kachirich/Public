# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in every CHANGE_ME value before running.
# NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# The orchestrator API this app talks to server-side (never from the browser).
ORCHESTRATOR_URL=http://localhost:3000
# Must match the orchestrator's own INTERNAL_SHARED_SECRET.
INTERNAL_SHARED_SECRET=CHANGE_ME

# Public origin the QR posters encode; set to your real domain in production
# so scanned codes resolve for anyone, not just localhost.
PUBLIC_WEB_URL=http://localhost:3002

# Admin portal token — the second factor on top of the AuthKit session
# required by middleware.ts for everything under /admin.
ADMIN_TOKEN=CHANGE_ME

# apps/authkit-service — required for the AuthKit gate on /pro and /admin
# (see src/middleware.ts). In production this is https://auth.flowgateway.dev.
AUTHKIT_URL=http://localhost:4000
# Must match apps/authkit-service's own COOKIE_DOMAIN exactly — used to
# correctly clear the shared session cookie on logout. Leave unset in
# development (a leading-dot Domain is invalid for "localhost").
AUTHKIT_COOKIE_DOMAIN=
