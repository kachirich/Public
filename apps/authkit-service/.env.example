# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every CHANGE_ME value before running.
# NEVER commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this service with credentials.
CORS_ORIGIN=http://localhost:4000,http://localhost:3002

# Public URL of this service — used to build the link inside password-reset
# emails. Named AUTHKIT_BASE_URL (not BASE_URL) because tooling in this
# monorepo (Vite/Vitest) predefines a plain BASE_URL env var of its own.
AUTHKIT_BASE_URL=http://localhost:4000

# JWT — generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Resend — transactional email API key (https://resend.com), used for
# password-reset emails.
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Professional Access AuthKit <security@CHANGE_ME.example>

# PostgreSQL — this service owns its own `users` / `password_resets` tables.
# Point it at a dedicated database/schema, not the orchestrator's database.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGDATABASE=authkit
# Set to "true" when connecting to a managed Postgres instance that requires
# TLS (e.g. RDS, Render, Railway) with a certificate not in the default
# trust store.
PGSSL=false
