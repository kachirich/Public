# Shared
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_dev
REDIS_URL=redis://localhost:6379
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string

# apps/orchestrator
PORT=3000

# apps/orchestrator — providers (optional in dev; log adapter used when absent)
# CALCOM_API_URL=https://cal.example.com/api/v1
# CALCOM_API_KEY=cal_xxx
# PAYSTACK_SECRET_KEY=sk_test_xxx
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Marketplace <no-reply@example.com>
# WA_GATEWAY_URL=http://localhost:3001

# apps/wa-gateway (run as a separate process with its own PORT)
# PORT=3001
ORCHESTRATOR_BASE_URL=http://localhost:3000
OPENWA_API_URL=http://localhost:2785
# OPENWA_API_KEY=openwa-key
